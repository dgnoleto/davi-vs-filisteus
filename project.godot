; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Davi vs Filisteus"
config/description="Jogo mobile de física com mecânica híbrida, combinando puzzles balísticos de estilingue e combate tático contra inimigos que avançam e atacam de volta.

Inspirado na narrativa bíblica de 1 Samuel 17, o jogador assume o papel do jovem pastor Davi. O objetivo é proteger a tenda do acampamento e o rebanho contra predadores e invasores, progredindo do Leão e do Urso até o exército dos Filisteus (Lanceiros, Arqueiros e Escudeiros) e o confronto épico com o gigante Golias.

Destaques de jogabilidade e design:
- Mecânica de mira e lançamento de pedras com física 2D e trajetória preditiva.
- Sistema de vida indireto centrado na tenda de Davi (Intacta -> Danificada -> Destruída).
- Inimigos dinâmicos com comportamentos corpo a corpo e projéteis à distância.
- NPCs de ovelhas com reações de alerta e fugas cômicas.
- Direção de arte clássica 'rubber hose animation' (estilo anos 20/30) com identidade visual unificada em tom teal (#56837E)."
config/version="0.1.0"
config/features=PackedStringArray("4.7")

[autoload]

_fennara_game_capture="*res://addons/fennara/runtime/game_capture_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
